# 主程序 main.py 的设置项（系统环境变量优先级高于本文件）
# IMG_PATH 可以不写后缀：会自动匹配 .png/.jpg/.jpeg/.bmp/.webp/.tif（忽略大小写），
# 例："assets/lina"、"flowers"、"cap" 都能找到对应图片
IMG_PATH = "assets/flowers.png"

# 默认识别的颜色，可写 blue / yellow / green / red（一次只识别一种）
DEFAULT_COLOR = "blue"

# 统计信息里最多列出几个区域（超出部分只显示数量）
MAX_LISTED_REGIONS = 5

# 显示窗口的最大宽度（px）。0 或不设 = 不限制：拼接图按原始分辨率显示，画质不变；
# 若窗口过宽超出屏幕，可设成 1600 之类的正数让它自动缩小（会降低画质）
DISPLAY_MAX_WIDTH = 0
